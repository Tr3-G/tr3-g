# ==============================================================================
# TR3-G INNOVATIONS LIMITED — ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE (PostgreSQL / Neon / Supabase)
# ------------------------------------------------------------------------------
# Primary relational database connection string for all CMS data, BioData,
# Attendance, Applications, Gallery, and Reports.
DATABASE_URL=postgresql://neondb_owner:password@ep-host-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# ------------------------------------------------------------------------------
# 2. AUTHENTICATION & SECURITY
# ------------------------------------------------------------------------------
# Secret key used for signing administrative JWT session tokens.
# Change this to a strong random 32+ character string in production.
JWT_SECRET=tr3g-innovations-secure-jwt-key-change-in-prod

# ------------------------------------------------------------------------------
# 3. BREVO / SENDINBLUE (Transactional Email Delivery)
# ------------------------------------------------------------------------------
# Required for:
#  - Applicant job application receipts
#  - Staff operational report submission confirmations
#  - Admin report approval notices (with approving admin name)
#  - Admin broadcast / custom emails to staff, applicants, and contacts
BREVO_API_KEY=xkeysib-your-brevo-api-key-here
BREVO_SENDER_EMAIL=info@tr3-g.com.ng
BREVO_SENDER_NAME=TR3-G Innovations

# ------------------------------------------------------------------------------
# 4. CLOUDINARY (Media & Document Uploads)
# ------------------------------------------------------------------------------
# Required for:
#  - BioData passports and front/back identification card uploads
#  - Team member photos and partner logos
#  - Staff report attachments (PDFs, images, spreadsheets)
#  - Admin Gallery media (images and videos)
#  - Job applicant CV / resume document uploads
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_UPLOAD_PRESET=your_unsigned_preset_optional
